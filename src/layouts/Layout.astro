---
import '../styles/global.css';
const {title='Linis Co — A little clean. A lot of calm.',description='Regular home, office, deep, steam, move-in/move-out, carpet, upholstery and window cleaning in Pasig, Metro Manila and nearby provinces.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#254e3d"/><title>{title}</title><link rel="icon" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet"/></head><body><a class="skip" href="#main">Skip to content</a><div class="announcement">A fresher space. A lighter day. <span>Serving Metro Manila & beyond ↗</span></div><header><a href="/" class="brand" aria-label="Linis Co home"><span class="brand-mark">✳</span> linis<span class="brand-co">co.</span></a><nav aria-label="Main navigation"><a href="/#services">Our services</a><a href="/#difference">Why Linis Co</a><a href="/#our-work">Our work</a><a href="/#areas">Service areas</a></nav><a class="button small" href="/#quote">Get a free quote <span>↗</span></a><button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">☰</button></header><main id="main"><slot/></main><footer><div class="footer-top"><a href="/" class="brand"><span class="brand-mark">✳</span> linis<span class="brand-co">co.</span></a><p>A cleaner space.<br/>More room for life.</p><div><a href="tel:+639618062218">+63 961 806 2218</a><a href="https://m.me/liniscoph/" target="_blank" rel="noreferrer">Chat on Messenger ↗</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Linis Co Cleaning Services</span><a href="/privacy">Privacy & enquiries</a><span>Convenience. Comfort. Competent.</span></div></footer><nav class="bottom-actions" aria-label="Quick contact"><a class="bottom-quote" href="/#quote">Free quote <span aria-hidden="true">↗</span></a><a class="bottom-call" href="tel:+639618062218"><span aria-hidden="true">☎</span> Call now</a></nav><script>import gsap from 'gsap';
const toggle=document.querySelector('.menu-toggle'); toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));document.querySelector('header nav')?.classList.toggle('open',open)});document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>{document.querySelector('header nav')?.classList.remove('open');toggle?.setAttribute('aria-expanded','false')}));
if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){gsap.from('.hero-copy > *',{y:24,opacity:0,duration:.85,stagger:.12,ease:'power2.out'});const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){gsap.fromTo(e.target,{y:22,opacity:.3},{y:0,opacity:1,duration:.7});observer.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));}
</script></body></html>



